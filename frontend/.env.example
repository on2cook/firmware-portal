# Point the portal at your API. When unset it defaults to http://localhost:4000/api
# Copy this file to ".env" for local overrides, or set VITE_API_BASE in your
# hosting provider's (e.g. Vercel) environment variables for deployed builds —
# it is baked in at BUILD time, so changing it requires a rebuild.
# VITE_API_BASE=https://your-api-domain.com/api
