# Firmware Portal backend configuration — copy this file to ".env" and fill in
# real values:  cp .env.example .env
# Everything below is read by src/db.js, src/index.js and src/services/googleDrive.js.

# ---- Server ----
PORT=4000
# Comma-separated list of allowed browser origins for CORS ("*" allows any).
CORS_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL) ----
# Either a full connection string:
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/firmware_portal
# ...or individual variables (used when DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=firmware_portal
# PGUSER=postgres
# PGPASSWORD=YOUR_PASSWORD

# ---- Auth ----
# Any long random string used to sign login tokens.
JWT_SECRET=change_me_to_a_long_random_string

# ---- First admin account (created automatically on first boot) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change_me_now

# ---- Google Drive storage ----
# Root folder for all uploads ("root" = top level of your Drive).
GOOGLE_DRIVE_ROOT_FOLDER_ID=root
# Option A — personal Gmail account (recommended): OAuth refresh token.
# From the backend folder run:  npm run get-refresh-token
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Option B — Workspace service account + Shared Drive:
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_KEY_JSON=
